{
  "name": "danka-pos",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run build --filter=@pos/api... && turbo run typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "turbo run build --filter=@pos/api... && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @pos/db generate",
    "db:migrate": "pnpm --filter @pos/db migrate",
    "db:seed": "pnpm --filter @pos/db seed",
    "infra:up": "docker compose --env-file .env -f infra/docker/compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker/compose.yml down",
    "api:export": "node --import tsx scripts/export-openapi.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "dotenv": "18.0.8",
    "tsx": "4.23.15",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "type": "module"
}

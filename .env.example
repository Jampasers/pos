NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
# Local-only examples. Replace every password before exposing services.
POSTGRES_PASSWORD=local-admin-change-me
APP_DB_PASSWORD=local-app-change-me
DATABASE_ADMIN_URL=postgresql://postgres:local-admin-change-me@127.0.0.1:5432/pos
DATABASE_URL=postgresql://pos_app:local-app-change-me@127.0.0.1:5432/pos
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4000
SESSION_TTL_SECONDS=28800
SEED_PASSWORD=
SEED_ENABLED=false
REDIS_PASSWORD=local-redis-change-me
REDIS_URL=redis://:local-redis-change-me@127.0.0.1:6379
S3_ROOT_USER=pos-local
S3_ROOT_PASSWORD=local-storage-change-me
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=pos-assets
# Observability credentials and exporters are added in MVP hardening.

INTEGRATION_TEST_ENABLED=false
